# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Full-resolution source photographs. Never published — the build emits capped
# derivatives instead, so originals are not downloadable from the live site and
# do not count against the 1 GB GitHub Pages limit.
# See docs/decisions/0003-precomputed-image-pipeline.md
/_originals/

# Everything the photo pipeline derives from photos/. Regenerated by
# `npm run photos`, which runs automatically before dev, typecheck and build, and
# in CI on every deploy. `photos/` is the only image source in version control.
/public/img/
/src/data/photos.generated.json
/.photo-cache.json
